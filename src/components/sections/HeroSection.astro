---
import heroPreview from '../../assets/screenshot/hero-preview-01.png';
---

<section class="hero-section" aria-labelledby="hero-title">
	<div class="hero-copy">
		<p class="eyebrow">Performance coaching for real life</p>
		<h1 id="hero-title">Build your strongest routine, one focused session at a time.</h1>
		<p class="lead">
			WeFitNest turns your training goals into a clear daily plan with adaptive workouts,
			progress insights, and recovery-friendly pacing.
		</p>
		<div class="cta-row">
			<a class="cta cta-primary" href="#app-store">Get the App</a>
			<a class="cta cta-secondary" href="#tutorial">See How It Works</a>
		</div>
		<ul class="hero-pills" aria-label="Core benefits">
			<li>Adaptive workout plans</li>
			<li>Clear progress tracking</li>
			<li>Coach-level structure</li>
		</ul>
	</div>

	<div class="hero-visual" aria-hidden="true">
		<div class="visual-orb orb-one"></div>
		<div class="visual-orb orb-two"></div>
		<figure class="device-card">
			<img
				src={heroPreview.src}
				alt="WeFitNest workout dashboard screenshot showing a daily training plan"
				width={heroPreview.width}
				height={heroPreview.height}
				loading="eager"
				fetchpriority="high"
			/>
			<figcaption>
				<span>Today’s plan</span>
				<strong>Upper body focus with recovery-aware pacing</strong>
			</figcaption>
		</figure>
		<div class="floating-pill top">AI plan adjusted for recovery</div>
		<div class="floating-pill bottom">Streak: 18 days</div>
	</div>
</section>

<style>
	.hero-section {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: var(--wf-space-6) auto 0;
		padding: clamp(1.2rem, 3vw, 2rem);
		display: grid;
		gap: var(--wf-space-8);
		border-radius: var(--wf-radius-panel);
		background: linear-gradient(160deg, var(--wf-color-surface) 0%, rgba(255, 255, 255, 0.52) 100%);
		backdrop-filter: blur(18px);
		border: 1px solid rgba(255, 255, 255, 0.82);
		box-shadow: var(--wf-shadow-soft);
		overflow: clip;
		position: relative;
	}

	.hero-section::before,
	.hero-section::after {
		content: '';
		position: absolute;
		border-radius: 999px;
		pointer-events: none;
	}

	.hero-section::before {
		inset: -10% auto auto -12%;
		width: 15rem;
		height: 15rem;
		background: radial-gradient(circle, rgba(104, 205, 255, 0.42) 0%, rgba(104, 205, 255, 0) 72%);
	}

	.hero-section::after {
		inset: auto -10% -18% auto;
		width: 17rem;
		height: 17rem;
		background: radial-gradient(circle, rgba(77, 236, 180, 0.34) 0%, rgba(77, 236, 180, 0) 72%);
	}

	.hero-copy {
		display: grid;
		gap: var(--wf-space-5);
		animation: hero-reveal var(--wf-motion-slow) var(--wf-ease-standard) both;
		position: relative;
		z-index: 1;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 0.45rem 0.95rem;
		border-radius: var(--wf-radius-pill);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--wf-color-brand-deep);
		background: rgba(13, 138, 223, 0.12);
		border: 1px solid rgba(13, 138, 223, 0.22);
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.8rem);
		line-height: 0.96;
		max-width: 11ch;
		text-wrap: balance;
		letter-spacing: -0.04em;
	}

	.lead {
		font-size: clamp(1rem, 2.4vw, 1.16rem);
		line-height: 1.7;
		max-width: 50ch;
		color: var(--wf-color-text-muted);
	}

	.cta-row {
		display: flex;
		gap: var(--wf-space-3);
		flex-wrap: wrap;
		animation: section-stagger var(--wf-motion-slow) var(--wf-ease-standard) 120ms both;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.92rem 1.35rem;
		border-radius: var(--wf-radius-pill);
		font-weight: 800;
		text-decoration: none;
		transition:
			transform var(--wf-motion-fast) var(--wf-ease-standard),
			box-shadow var(--wf-motion-fast) var(--wf-ease-standard),
			background var(--wf-motion-fast) var(--wf-ease-standard);
	}

	.cta-primary {
		background: var(--wf-gradient-brand);
		color: #ffffff;
		box-shadow: var(--wf-shadow-glow);
		animation: cta-emphasis 2.6s var(--wf-ease-standard) infinite;
	}

	.cta-primary:hover,
	.cta-primary:focus-visible {
		transform: translateY(-2px) scale(1.01);
		box-shadow: 0 16px 36px rgba(8, 120, 176, 0.36);
	}

	.cta-secondary {
		background: rgba(255, 255, 255, 0.94);
		border: 1px solid var(--wf-color-border);
		color: var(--wf-color-brand-deep);
	}

	.cta-secondary:hover,
	.cta-secondary:focus-visible {
		transform: translateY(-2px);
		box-shadow: var(--wf-shadow-soft);
	}

	.hero-pills {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		gap: var(--wf-space-2);
		flex-wrap: wrap;
		animation: section-stagger var(--wf-motion-slow) var(--wf-ease-standard) 180ms both;
	}

	.hero-pills li {
		padding: 0.58rem 0.95rem;
		border-radius: var(--wf-radius-pill);
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--wf-color-brand-deep);
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid rgba(13, 138, 223, 0.14);
	}

	.hero-visual {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 25rem;
		animation: section-stagger var(--wf-motion-slow) var(--wf-ease-standard) 220ms both;
	}

	.visual-orb {
		position: absolute;
		border-radius: 999px;
		filter: blur(4px);
	}

	.orb-one {
		inset: 8% auto auto 8%;
		width: 9rem;
		height: 9rem;
		background: radial-gradient(circle, rgba(45, 189, 255, 0.34) 0%, rgba(45, 189, 255, 0) 72%);
	}

	.orb-two {
		inset: auto 10% 10% auto;
		width: 10rem;
		height: 10rem;
		background: radial-gradient(circle, rgba(49, 224, 167, 0.28) 0%, rgba(49, 224, 167, 0) 72%);
	}

	.device-card {
		width: min(22rem, 100%);
		margin: 0;
		padding: var(--wf-space-4);
		border-radius: var(--wf-radius-card);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.96) 0%, rgba(235, 252, 255, 0.86) 100%) padding-box,
			linear-gradient(135deg, rgba(13, 138, 223, 0.56), rgba(28, 200, 184, 0.56)) border-box;
		border: 1px solid transparent;
		box-shadow: 0 22px 50px rgba(6, 73, 107, 0.22);
		display: grid;
		gap: var(--wf-space-3);
		position: relative;
		z-index: 1;
	}

	.device-card img {
		width: 100%;
		height: auto;
		border-radius: calc(var(--wf-radius-card) - 0.75rem);
		box-shadow: 0 10px 26px rgba(4, 40, 61, 0.16);
	}

	.device-card figcaption {
		display: grid;
		gap: var(--wf-space-1);
		padding: 0 0.2rem 0.1rem;
	}

	.device-card span {
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--wf-color-brand-deep);
	}

	.device-card strong {
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--wf-color-text);
	}

	.floating-pill {
		position: absolute;
		padding: 0.65rem 0.95rem;
		border-radius: var(--wf-radius-pill);
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(10px);
		font-size: 0.78rem;
		font-weight: 800;
		color: var(--wf-color-brand-deep);
		box-shadow: var(--wf-shadow-soft);
		border: 1px solid rgba(13, 138, 223, 0.14);
		z-index: 2;
	}

	.floating-pill.top {
		top: 1rem;
		left: 0;
	}

	.floating-pill.bottom {
		right: 0;
		bottom: 0.8rem;
	}

	@keyframes hero-reveal {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes section-stagger {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes cta-emphasis {
		0%,
		100% {
			box-shadow: var(--wf-shadow-glow);
		}
		50% {
			box-shadow: 0 16px 36px rgba(10, 138, 206, 0.42);
		}
	}

	@media (min-width: 900px) {
		.hero-section {
			grid-template-columns: 1.08fr 0.92fr;
			align-items: center;
			padding: clamp(1.5rem, 3vw, 2.5rem);
		}

		.hero-copy {
			padding: var(--wf-space-4) 0 var(--wf-space-4) var(--wf-space-2);
		}

		.hero-visual {
			min-height: 33rem;
		}
	}

	@media (max-width: 520px) {
		.hero-section {
			width: min(var(--wf-content-width), calc(100% - var(--wf-space-4)));
			margin-top: var(--wf-space-4);
			padding: var(--wf-space-5);
			border-radius: var(--wf-radius-card);
		}

		h1 {
			max-width: 12ch;
		}

		.hero-visual {
			min-height: 21rem;
		}

		.device-card {
			width: min(19rem, 100%);
			padding: var(--wf-space-3);
		}

		.floating-pill {
			font-size: 0.72rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-copy,
		.cta-row,
		.hero-pills,
		.hero-visual,
		.cta-primary {
			animation: none;
		}

		.cta {
			transition: none;
		}
	}
</style>