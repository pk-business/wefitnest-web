---
---

<section class="hero-section" aria-labelledby="hero-title">
	<div class="hero-panel" data-reveal data-parallax="8">
		<p class="eyebrow">Minimal training intelligence</p>
		<h1 id="hero-title">A calmer way to build unstoppable fitness momentum.</h1>
		<p class="lead">
			Adaptive routines, thoughtful pacing, and elegant progress signals designed to keep you
			moving every day.
		</p>
		<div class="cta-row">
			<a class="cta cta-primary" href="#app-store">Download App</a>
		</div>
	</div>
</section>

<style>
	.hero-section {
		min-height: 60svh;
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-5)));
		margin: 0 auto;
      margin-top: 3rem;
		display: grid;
		place-items: center;
		position: relative;
	}

	.hero-panel {
		width: 100%;
		padding: clamp(1.4rem, 4vw, 2.6rem);
		display: grid;
		justify-items: center;
		gap: var(--wf-space-4);
		text-align: center;
		border-radius: var(--wf-radius-panel);
		background: var(--wf-color-surface);
		backdrop-filter: blur(18px);
		border: 1px solid var(--wf-color-border);
		box-shadow: var(--wf-shadow-soft);
		animation: hero-load var(--wf-motion-slow) var(--wf-ease-standard) both;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 0.42rem 0.86rem;
		/* border-radius: var(--wf-radius-pill); */
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--wf-color-text-muted);
		/* background: rgba(255, 255, 255, 0.08); */
		border-bottom: 1px solid rgba(255, 255, 255, 0.16);
	}

	h1 {
		font-size: clamp(2.2rem, 9vw, 4.6rem);
		line-height: 0.94;
		max-width: 12ch;
		text-wrap: balance;
		letter-spacing: -0.035em;
		color: var(--wf-color-text);
	}

	.lead {
		font-size: clamp(0.98rem, 2.2vw, 1.13rem);
		line-height: 1.7;
		max-width: 46ch;
		color: var(--wf-color-text-muted);
	}

	.cta-row {
		display: flex;
		justify-content: center;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.92rem 1.5rem;
		border-radius: var(--wf-radius-pill);
		font-weight: 700;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition:
			transform var(--wf-motion-fast) var(--wf-ease-standard),
			box-shadow var(--wf-motion-fast) var(--wf-ease-standard),
			background var(--wf-motion-fast) var(--wf-ease-standard);
	}

	.cta-primary {
		background: linear-gradient(135deg, #2196f3 0%, #00bcd4 60%, #14cba8 100%);
		color: #111111;
		box-shadow: var(--wf-shadow-glow);
	}

	.cta-primary:hover,
	.cta-primary:focus-visible {
		transform: translateY(-2px) scale(1.01);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
	}

	@keyframes hero-load {
		from {
			opacity: 0;
			transform: translate3d(0, 14px, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	@media (max-width: 520px) {
		.hero-section {
			width: min(var(--wf-content-width), calc(100% - var(--wf-space-4)));
      margin-top: 0px;
		}

		.hero-panel {
			padding: var(--wf-space-5);
			border-radius: var(--wf-radius-card);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-panel,
		.cta {
			animation: none;
			transition: none;
		}
	}
</style>