---
interface Props {
	kicker?: string;
	title: string;
	description: string;
	center?: boolean;
	id?: string;
}

const { kicker, title, description, center = false, id } = Astro.props;
---

<header class:list={["section-header", { center }]}>
	{kicker ? <p class="kicker">{kicker}</p> : null}
	<h2 id={id}>{title}</h2>
	<p>{description}</p>
</header>

<style>
	.section-header {
		display: grid;
		gap: var(--wf-space-3);
		max-width: 44rem;
		position: relative;
		z-index: 1;
	}

	.center {
		justify-items: center;
		text-align: center;
		margin-inline: auto;
	}

	.kicker {
		margin: 0;
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 0.4rem 0.85rem;
		border-radius: var(--wf-radius-pill);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--wf-color-text-muted);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.14);
	}

	h2 {
		font-size: clamp(1.7rem, 4vw, 2.9rem);
		max-width: 16ch;
		text-wrap: balance;
	}

	p:last-child {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--wf-color-text-muted);
		max-width: 56ch;
	}

	.center p:last-child {
		max-width: 44ch;
	}
</style>