---
import SectionHeader from './SectionHeader.astro';

const steps = [
	{
		title: 'Onboarding and setup',
		purpose: 'Create your profile, pick your training goal, and set up the baseline the app should use.',
		benefit: 'You start with a plan that reflects your current routine instead of a generic template.',
		steps: ['Choose your goal', 'Confirm your schedule', 'Review the starter plan'],
		tips: 'Keep the first setup honest. Accurate inputs make the plan more useful.',
	}
];
---

<section id="tutorial" class="section-block tutorial-block" aria-labelledby="tutorial-title">
	<SectionHeader
		kicker="Tutorial preview"
		title="Follow the flow from setup to progress review."
		description="This is the practical path the site should explain: start with setup, build workouts, train with pacing, log nutrition, and review the numbers that matter."
		id="tutorial-title"
	/>

	<div class="tutorial-grid">
		{steps.map((step, index) => (
			<article class={`tutorial-card tutorial-card-${index + 1}`}>
				<div class="card-top">
					<span>Step {index + 1}</span>
					<strong>{step.title}</strong>
				</div>
				<p class="purpose"><strong>What it does:</strong> {step.purpose}</p>
				<p class="benefit"><strong>Why it matters:</strong> {step.benefit}</p>
				<div class="step-list">
					<p class="mini-heading">How to use it</p>
					<ol>
						{step.steps.map((item) => <li>{item}</li>)}
					</ol>
				</div>
				<p class="tip"><strong>Tip:</strong> {step.tips}</p>
			</article>
		))}

    <div class="tutorial-footer">
      <a class="cta cta-secondary" href="/tutorial">Read the full tutorial →</a>
    </div>
	</div>

</section>

<style>
	.section-block {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: 0 auto;
		display: grid;
		gap: var(--wf-space-6);
	}

	.tutorial-grid {
		display: flex;
    align-items: center;
		gap: var(--wf-space-4);
	}

	.tutorial-card {
		padding: var(--wf-space-5);
		/* border-radius: var(--wf-radius-card); */
		/* background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(246, 252, 255, 0.88) 100%);
		border: 1px solid rgba(13, 138, 223, 0.12); */
		box-shadow: 0 16px 36px rgba(4, 40, 61, 0.08);
		display: grid;
		gap: var(--wf-space-3);
		position: relative;
		overflow: clip;
		animation: section-stagger var(--wf-motion-slow) var(--wf-ease-standard) both;
	}

	.tutorial-card::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: 0.35rem;
		background: var(--wf-gradient-brand);
	}

	.card-top {
		display: grid;
		gap: var(--wf-space-1);
	}

	.card-top span {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--wf-color-brand-deep);
	}

	.card-top strong {
		font-size: 1.2rem;
		line-height: 1.25;
	}

	p {
		line-height: 1.65;
		color: var(--wf-color-text-muted);
	}

	strong {
		color: var(--wf-color-text);
	}

	.mini-heading {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--wf-color-brand-deep);
	}

	ol {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: var(--wf-space-2);
	}

	li {
		color: var(--wf-color-text);
	}

	@media (min-width: 760px) {
		.tutorial-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1120px) {
		.tutorial-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.tutorial-footer {
		justify-self: end;
    .cta {
      padding: 0.88rem 1.5rem;
      border-radius: var(--wf-radius-pill);
      font-weight: 700;
      text-decoration: none;
      transition:
        transform var(--wf-motion-fast) var(--wf-ease-standard),
        box-shadow var(--wf-motion-fast) var(--wf-ease-standard);
    }

    .cta-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: var(--wf-color-text);
      border: 1px solid var(--wf-color-border);
    }
  }

	.cta:hover,
	.cta:focus-visible {
		transform: translateY(-2px);
	}
</style>