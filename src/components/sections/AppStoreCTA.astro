---
import appIcon from '../../assets/AppIcon-1024.png';

const year = new Date().getFullYear();
---

<section id="app-store" class="section-block app-store-block" aria-labelledby="app-store-title">
	<div class="cta-card">
		<div class="cta-copy">
			<p class="kicker">Download</p>
			<h2 id="app-store-title">Ready for the most focused version of your training week?</h2>
			<p>
				Install WeFitNest and keep your workouts, pacing, and recovery signals in one elegant flow.
			</p>
			<div class="cta-row">
				<a class="cta cta-primary" href="#">Download on the App Store</a>
				<a class="cta cta-secondary" href="#screenshots">Preview interface</a>
			</div>
		</div>
		<figure class="store-figure">
			<img
				src={appIcon.src}
				alt="WeFitNest app icon placeholder for the App Store call to action"
				width={appIcon.width}
				height={appIcon.height}
				loading="lazy"
				decoding="async"
			/>
			<figcaption>Built for mobile-first training routines.</figcaption>
		</figure>
	</div>
	<footer class="copyright" aria-label="Site copyright">
		<p>Copyright {year} wefitnest.com. All rights reserved.</p>
	</footer>
</section>

<style>
	.section-block {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: 0 auto var(--wf-space-10);
		display: grid;
		gap: var(--wf-space-6);
	}

	.cta-card {
		padding: clamp(1.2rem, 3vw, 2rem);
		border-radius: var(--wf-radius-panel);
		background: var(--wf-color-surface);
		backdrop-filter: blur(18px);
		border: 1px solid var(--wf-color-border);
		color: var(--wf-color-text);
		box-shadow: var(--wf-shadow-soft);
		display: grid;
		gap: var(--wf-space-5);
		position: relative;
		overflow: clip;
	}

	.cta-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0));
		pointer-events: none;
	}

	.cta-copy,
	.store-figure {
		position: relative;
		z-index: 1;
	}

	.cta-copy {
		display: grid;
		gap: var(--wf-space-4);
		max-width: 42rem;
	}

	.kicker {
		margin: 0;
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 0.42rem 0.88rem;
		border-radius: var(--wf-radius-pill);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		background: rgba(255, 255, 255, 0.06);
		color: var(--wf-color-text-muted);
		border: 1px solid rgba(255, 255, 255, 0.14);
	}

	h2 {
		font-size: clamp(1.8rem, 4.5vw, 3rem);
		line-height: 1;
		max-width: 16ch;
	}

	p {
		max-width: 46ch;
		line-height: 1.7;
		color: var(--wf-color-text-muted);
	}

	.cta-row {
		display: flex;
		gap: var(--wf-space-3);
		flex-wrap: wrap;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.92rem 1.25rem;
		border-radius: var(--wf-radius-pill);
		font-weight: 700;
		text-decoration: none;
		transition:
			transform var(--wf-motion-fast) var(--wf-ease-standard),
			box-shadow var(--wf-motion-fast) var(--wf-ease-standard);
	}

	.cta-primary {
		color: #101010;
		background: linear-gradient(140deg, #f5f5f5 0%, #d6d6d6 100%);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
	}

	.cta-secondary {
		color: var(--wf-color-text);
		border: 1px solid var(--wf-color-border);
		background: rgba(255, 255, 255, 0.08);
	}

	.cta:hover,
	.cta:focus-visible {
		transform: translateY(-2px);
	}

	.store-figure {
		margin: 0;
		display: grid;
		justify-items: start;
		gap: var(--wf-space-3);
	}

	.store-figure img {
		width: 6rem;
		height: 6rem;
		border-radius: 1.4rem;
		/* filter: grayscale(1); */
		box-shadow: 0 18px 32px rgba(0, 0, 0, 0.25);
	}

	.store-figure figcaption {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--wf-color-text-muted);
	}

	@media (min-width: 860px) {
		.cta-card {
			grid-template-columns: 1.1fr 0.9fr;
			align-items: center;
		}

		.store-figure {
			justify-self: end;
		}
	}

	.copyright {
		margin-top: var(--wf-space-3);
		padding: 0 var(--wf-space-2);
		text-align: center;
	}

	.copyright p {
		font-size: 0.82rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: rgba(235, 235, 235, 0.9);
	}
</style>