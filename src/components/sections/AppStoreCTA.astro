---
import appIcon from '../../assets/AppIcon-1024.png';
---

<section id="app-store" class="section-block app-store-block" aria-labelledby="app-store-title">
	<div class="cta-card">
		<div class="cta-copy">
			<p class="kicker">App Store CTA</p>
			<h2 id="app-store-title">Train with a system that is built for consistency.</h2>
			<p>
				Open WeFitNest to get a focused plan, a better workout flow, and the feedback loop you
				need to keep showing up.
			</p>
			<div class="cta-row">
				<a class="cta cta-primary" href="#">Download on the App Store</a>
				<a class="cta cta-secondary" href="#screenshots">View screenshots</a>
			</div>
		</div>
		<figure class="store-figure">
			<img
				src={appIcon.src}
				alt="WeFitNest app icon placeholder for the App Store call to action"
				width={appIcon.width}
				height={appIcon.height}
				loading="lazy"
				decoding="async"
			/>
			<figcaption>Built for mobile-first training routines.</figcaption>
		</figure>
	</div>
</section>

<style>
	.section-block {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: 0 auto;
		display: grid;
		gap: var(--wf-space-6);
	}

	.cta-card {
		padding: clamp(1.2rem, 3vw, 2rem);
		border-radius: var(--wf-radius-panel);
		background: linear-gradient(135deg, rgba(11, 101, 180, 0.98) 0%, rgba(16, 169, 198, 0.97) 55%, rgba(54, 225, 173, 0.96) 100%);
		color: #ffffff;
		box-shadow: 0 24px 52px rgba(6, 73, 107, 0.24);
		display: grid;
		gap: var(--wf-space-5);
		position: relative;
		overflow: clip;
	}

	.cta-card::before {
		content: '';
		position: absolute;
		inset: auto -8% -20% auto;
		width: 14rem;
		height: 14rem;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
	}

	.cta-copy,
	.store-figure {
		position: relative;
		z-index: 1;
	}

	.cta-copy {
		display: grid;
		gap: var(--wf-space-4);
		max-width: 42rem;
	}

	.kicker {
		margin: 0;
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 0.42rem 0.88rem;
		border-radius: var(--wf-radius-pill);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		background: rgba(255, 255, 255, 0.16);
		border: 1px solid rgba(255, 255, 255, 0.22);
	}

	h2 {
		font-size: clamp(1.8rem, 4.5vw, 3rem);
		line-height: 1;
		max-width: 13ch;
	}

	p {
		max-width: 46ch;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.9);
	}

	.cta-row {
		display: flex;
		gap: var(--wf-space-3);
		flex-wrap: wrap;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.92rem 1.25rem;
		border-radius: var(--wf-radius-pill);
		font-weight: 800;
		text-decoration: none;
		transition:
			transform var(--wf-motion-fast) var(--wf-ease-standard),
			box-shadow var(--wf-motion-fast) var(--wf-ease-standard);
	}

	.cta-primary {
		color: var(--wf-color-brand-deep);
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 14px 30px rgba(4, 40, 61, 0.18);
	}

	.cta-secondary {
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.26);
		background: rgba(255, 255, 255, 0.08);
	}

	.cta:hover,
	.cta:focus-visible {
		transform: translateY(-2px);
	}

	.store-figure {
		margin: 0;
		display: grid;
		justify-items: start;
		gap: var(--wf-space-3);
	}

	.store-figure img {
		width: 6rem;
		height: 6rem;
		border-radius: 1.4rem;
		box-shadow: 0 18px 32px rgba(4, 40, 61, 0.22);
	}

	.store-figure figcaption {
		font-size: 0.9rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.92);
	}

	@media (min-width: 860px) {
		.cta-card {
			grid-template-columns: 1.1fr 0.9fr;
			align-items: center;
		}

		.store-figure {
			justify-self: end;
		}
	}
</style>