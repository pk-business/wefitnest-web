---
import SectionHeader from './SectionHeader.astro';
import imgAdaptivePlans from '../../assets/img/adaptive-plans.jpg';
import imgSmartPacing from '../../assets/img/smart-pacing.jpg';
import imgProgressSignals from '../../assets/img/progress-signals.jpg';
import imgRecoveryLogging from '../../assets/img/recovery-logging.jpg';

const features = [
	{
		title: 'Adaptive Plans',
		description: 'Daily workouts recalibrate around your energy, recovery, and available time.',
		icon: 'path',
		img: imgAdaptivePlans,
		imgSide: 'right',
	},
	{
		title: 'Smart Pacing',
		description: 'Rest intervals stay intentional so every set keeps quality and rhythm.',
		icon: 'clock',
		img: imgSmartPacing,
		imgSide: 'left',
	},
	{
		title: 'Progress Signals',
		description: 'Clarity-focused charts reveal momentum, not noise, across each training week.',
		icon: 'chart',
		img: imgProgressSignals,
		imgSide: 'right',
	},
	{
		title: 'Recovery Logging',
		description: 'Lightweight meal and habit logs connect nutrition to performance outcomes.',
		icon: 'spark',
		img: imgRecoveryLogging,
		imgSide: 'left',
	},
];
---

<section id="feature-highlights" class="section-block" aria-labelledby="feature-highlights-title">
	<SectionHeader
		kicker="Core value"
		title="Everything in WeFitNest is designed for one purpose — making consistency effortless."
		description="Your homepage should instantly show that WeFitNest isn’t just a list of workouts. It’s a structured training system with built‑in pacing, intelligent tracking, and real‑time feedback that guides users through every session."
		id="feature-highlights-title"
	/>

	<div class="feature-grid">
		{features.map((feature, index) => (
			<article
				class={`feature-card feature-${index + 1} img-${feature.imgSide}`}
				data-reveal
				data-parallax="4"
			>
				<div class="card-content">
					<span class="icon-wrap" aria-hidden="true">
						{feature.icon === 'path' && (
							<svg viewBox="0 0 24 24" role="img" focusable="false">
								<path d="M4 18c5 0 5-12 10-12 2.2 0 3.4 1.3 6 1.3" />
								<circle cx="4" cy="18" r="2" />
								<circle cx="14" cy="6" r="2" />
							</svg>
						)}
						{feature.icon === 'clock' && (
							<svg viewBox="0 0 24 24" role="img" focusable="false">
								<circle cx="12" cy="12" r="8" />
								<path d="M12 8v5l3 2" />
							</svg>
						)}
						{feature.icon === 'chart' && (
							<svg viewBox="0 0 24 24" role="img" focusable="false">
								<path d="M5 17V9" />
								<path d="M11 17V6" />
								<path d="M17 17v-4" />
								<path d="M3 19h18" />
							</svg>
						)}
						{feature.icon === 'spark' && (
							<svg viewBox="0 0 24 24" role="img" focusable="false">
								<path d="M12 3l1.8 4.8L19 9.6l-4.3 2.8L16.2 18 12 15.3 7.8 18l1.5-5.6L5 9.6l5.2-1.8z" />
							</svg>
						)}
					</span>
					<h3>{feature.title}</h3>
					<p class="card-copy">{feature.description}</p>
				</div>
				<div class="card-img-wrap" aria-hidden="true">
					<img
						src={feature.img.src}
						alt=""
						width={feature.img.width}
						height={feature.img.height}
						loading="lazy"
						decoding="async"
					/>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.section-block {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: 0 auto;
		display: grid;
		gap: var(--wf-space-8);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--wf-space-4);
	}

   /* ── Modern Feature Card ─────────────────────────────────────────────── */
.feature-card {
    grid-column: span 1;
    padding: var(--wf-space-5);
    border-radius: var(--wf-radius-card);
    position: relative;
    overflow: hidden;

    /* Modern glass surface */
    background: color-mix(in srgb, var(--wf-color-surface) 72%, transparent);
    backdrop-filter: blur(20px) saturate(1.35);

    /* Modern layered shadows */
    box-shadow:
      0 3px 8px rgba(0,0,0,0.05),
      0 12px 28px rgba(0,0,0,0.04);

    /* border: 1px solid var(--wf-color-border); */

    display: flex;
    align-items: center;
    gap: var(--wf-space-4);

    transition:
      transform 0.45s var(--wf-ease-standard),
      box-shadow 0.45s var(--wf-ease-standard),
      border-color 0.45s var(--wf-ease-standard);
}

/* Ambient light wash */
.feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
        140% 140% at 50% -20%,
        rgba(255,255,255,0.14),
        transparent 60%
    );
    pointer-events: none;
}

/* Gradient edge highlight */
.feature-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid transparent;
    background: linear-gradient(
        120deg,
        rgba(255,255,255,0.25),
        rgba(255,255,255,0.05)
    ) border-box;
    mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
}

/* Hover interaction */
.feature-card:hover {
    transform: translateY(-4px) scale(1.015);
    box-shadow:
      0 6px 16px rgba(0,0,0,0.06),
      0 18px 48px rgba(0,0,0,0.05);
    border-color: rgba(255,255,255,0.22);
}

/* ── Layout Variants ─────────────────────────────────────────────────── */
.feature-card.img-right {
    flex-direction: row;
}

.feature-card.img-left {
    flex-direction: row-reverse;
}


	/* ── Text content ──────────────────────────────────────────────── */
	.card-content {
		flex: 1 1 0;
		min-width: 0;
		display: grid;
		gap: var(--wf-space-3);
	}

	h3 {
		font-size: 1.2rem;
		line-height: 1.2;
	}

	.card-copy {
		color: var(--wf-color-text-muted);
		line-height: 1.6;
		font-size: 0.9rem;
	}

	/* ── Icon ──────────────────────────────────────────────────────── */
	.icon-wrap {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 0.85rem;
		background: linear-gradient(135deg, #2196f3, #00bcd4 60%, #14cba8);
		border: 1px solid rgba(255, 255, 255, 0.14);
		flex-shrink: 0;
	}

	.icon-wrap svg {
		width: 1.25rem;
		height: 1.25rem;
		stroke: var(--wf-color-text);
		fill: none;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.icon-wrap svg path[fill] {
		fill: rgba(255, 255, 255, 0.9);
		stroke: none;
	}

	/* ── Feature image ─────────────────────────────────────────────── */
	.card-img-wrap {
		flex: 0 0 38%;
		max-width: 38%;
		align-self: stretch;
		border-radius: calc(var(--wf-radius-card) - 0.35rem);
		overflow: hidden;
		position: relative;
	}

	.card-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		/* Grayscale to match monochrome design language */
		filter: grayscale(1) brightness(0.72) contrast(1.08);
		transition: filter 0.4s ease;
	}

	.feature-card:hover .card-img-wrap img {
		filter: grayscale(1) brightness(0.88) contrast(1.08);
	}

	/* ── Mobile: stack vertically, image below text ─────────────────── */
	@media (max-width: 719px) {
		.feature-card {
			grid-column: span 2;
			flex-direction: column !important;
		}

		.card-img-wrap {
			flex: none;
			max-width: 100%;
			width: 100%;
			height: 10rem;
			border-radius: calc(var(--wf-radius-card) - 0.35rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feature-card {
			transform: none !important;
		}
	}
</style>