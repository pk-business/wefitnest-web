---
import SectionHeader from './SectionHeader.astro';

const features = [
	{
		title: 'Guided workout planning',
		description:
			'Build structured sessions that adapt to your schedule and training focus without losing momentum.',
			tips: ['Set your weekly split', 'Pick the target focus', 'Review the plan before training'],
	},
	{
		title: 'Rest timer and pacing',
		description:
			'Keep rest periods intentional so the session stays efficient and your effort stays consistent.',
		tips: ['Start the timer on each set', 'Use the pacing cue', 'Resume when you are ready'],
	},
	{
		title: 'Progress charts and trends',
		description:
			'Track completion, volume, and consistency so you can see progress without manually building a spreadsheet.',
		tips: ['Check the weekly view', 'Compare current and past loads', 'Use trends to adjust training'],
	},
	{
		title: 'Nutrition tracking and logging',
		description:
			'Capture meals with a quick log flow that supports better recovery and a more complete picture of your day.',
		tips: ['Log meals soon after eating', 'Keep entries simple', 'Review intake patterns weekly'],
	},
];
---

<section id="feature-highlights" class="section-block" aria-labelledby="feature-highlights-title">
	<SectionHeader
		kicker="Core value"
		title="Everything is built to make consistency easier."
		description="The homepage should show that WeFitNest is not just a workout list. It is a structured training system with pacing, tracking, and feedback built into the flow."
		id="feature-highlights-title"
	/>

	<div class="feature-grid">
		{features.map((feature, index) => (
			<article class={`feature-card feature-${index + 1}`}>
				<p class="card-index">0{index + 1}</p>
				<h3>{feature.title}</h3>
				<p class="card-copy">{feature.description}</p>
				<ul>
					{feature.tips.map((tip) => <li>{tip}</li>)}
				</ul>
			</article>
		))}
	</div>
</section>

<style>
	.section-block {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: 0 auto;
		display: grid;
		gap: var(--wf-space-6);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: var(--wf-space-4);
	}

	.feature-card {
		grid-column: span 12;
		padding: var(--wf-space-5);
		border-radius: var(--wf-radius-card);
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 253, 255, 0.86) 100%);
		border: 1px solid rgba(13, 138, 223, 0.12);
		box-shadow: 0 16px 36px rgba(4, 40, 61, 0.08);
		display: grid;
		gap: var(--wf-space-3);
		position: relative;
		overflow: clip;
		animation: section-stagger var(--wf-motion-slow) var(--wf-ease-standard) both;
	}

	.feature-card::before {
		content: '';
		position: absolute;
		inset: 0 auto auto 0;
		width: 100%;
		height: 0.35rem;
		background: var(--wf-gradient-brand);
	}

	.card-index {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wf-color-brand-deep);
	}

	h3 {
		font-size: 1.35rem;
		line-height: 1.15;
	}

	.card-copy {
		color: var(--wf-color-text-muted);
		line-height: 1.65;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--wf-space-2);
	}

	li {
		padding: 0.75rem 0.9rem;
		border-radius: 0.95rem;
		background: rgba(13, 138, 223, 0.06);
		border: 1px solid rgba(13, 138, 223, 0.12);
		color: var(--wf-color-text);
		font-size: 0.95rem;
	}

	@media (min-width: 720px) {
		.feature-card {
			grid-column: span 6;
		}
	}

	@media (min-width: 1080px) {
		.feature-card {
			grid-column: span 3;
		}
	}
</style>