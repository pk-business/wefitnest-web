---
const year = new Date().getFullYear();

const faqs = [
	{
		question: 'Is WeFitNest beginner friendly?',
		answer: 'Yes. The setup and guided workout structure are meant to make the first week feel clear, not overwhelming.',
	},
	{
		question: 'Does the app help with workout pacing?',
		answer: 'Yes. Rest timer support and session flow keep workouts moving with a consistent rhythm.',
	},
	{
		question: 'Can I track meals too?',
		answer: 'Yes. Nutrition logging is part of the core flow so training and recovery can be viewed together.',
	},
	{
		question: 'What does the progress view show?',
		answer: 'Charts focus on completion, training trends, and the habits that help you stay consistent over time.',
	},
	{
		question: 'Will the app still feel clean on iPhone screens?',
		answer: 'The layout is designed mobile-first, with dense content broken into clear cards and readable spacing on narrow screens.',
	},
];
---

<section id="faq" class="section-block footer-cta" aria-labelledby="faq-title">
	<div class="faq-header">
		<p class="eyebrow">FAQ</p>
		<h2 id="faq-title">Questions people ask before they commit.</h2>
	</div>

	<div class="faq-list">
		{faqs.map((item) => (
			<details class="faq-item">
				<summary>{item.question}</summary>
				<p>{item.answer}</p>
			</details>
		))}
	</div>

	<footer class="site-footer">
		<p>WeFitNest</p>
		<nav aria-label="Footer links">
			<a href="#feature-highlights">Features</a>
			<a href="/tutorial">Tutorial</a>
			<a href="#screenshots">Screenshots</a>
			<a href="#faq">FAQ</a>
		</nav>
		<nav class="legal-links" aria-label="Legal links">
			<a href="/privacy-policy">Privacy Policy</a>
			<a href="/terms-of-use">Terms of Use</a>
			<a href="/health-disclaimer">Health Disclaimer</a>
			<a href="/data-deletion">Data Deletion</a>
		</nav>
	</footer>
	<footer class="copyright" aria-label="Site copyright">
		<p>Copyright {year} wefitnest.com. All rights reserved.</p>
	</footer>
</section>

<style>
	.section-block {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: 0 auto var(--wf-space-8);
		display: grid;
		gap: var(--wf-space-6);
	}

	.faq-header {
		display: grid;
		gap: var(--wf-space-3);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 0.42rem 0.88rem;
		border-radius: var(--wf-radius-pill);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--wf-color-text-muted);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid var(--wf-color-border);
	}

	h2 {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.8rem, 4.5vw, 3rem);
		line-height: 1;
		color: var(--wf-color-text);
	}

	.faq-list {
		display: grid;
		gap: var(--wf-space-3);
	}

	.faq-item {
		padding: var(--wf-space-4) var(--wf-space-5);
		border-radius: var(--wf-radius-card);
		background: var(--wf-color-surface);
		backdrop-filter: blur(18px);
		border: 1px solid var(--wf-color-border);
		box-shadow: var(--wf-shadow-soft);
	}

	summary {
		cursor: pointer;
		font-size: 1rem;
		font-weight: 800;
		color: var(--wf-color-text);
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.faq-item p {
		margin-top: var(--wf-space-3);
		line-height: 1.7;
		color: var(--wf-color-text-muted);
	}

	details[open] {
		border-color: rgba(33, 150, 243, 0.28);
	}

	.site-footer {
		display: flex;
		justify-content: space-between;
		gap: var(--wf-space-3);
		align-items: center;
		padding: 0.25rem 0.15rem 0;
		flex-wrap: wrap;
	}

	.site-footer p {
		margin: 0;
		font-weight: 800;
		color: var(--wf-color-text);
	}

	.site-footer nav {
		display: flex;
		gap: var(--wf-space-3);
		flex-wrap: wrap;
	}

	.site-footer a {
		text-decoration: none;
		font-weight: 700;
		color: var(--wf-color-text-muted);
	}

	.site-footer a:hover,
	.site-footer a:focus-visible {
		color: var(--wf-color-brand-deep);
	}

	.legal-links {
		width: 100%;
		display: flex;
		gap: var(--wf-space-3);
		flex-wrap: wrap;
		padding-top: 0.5rem;
		border-top: 1px solid var(--wf-color-border);
	}

	.legal-links a {
		font-size: 0.78rem;
		font-weight: 500;
	}

	.copyright {
		padding: 0 var(--wf-space-2);
		text-align: center;
	}

	.copyright p {
		font-size: 0.82rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--wf-color-text-muted);
	}
</style>