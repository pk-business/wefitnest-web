---
---

<section class="section-block footer-cta" aria-labelledby="footer-cta-title">
	<div class="footer-card">
		<div class="footer-copy">
			<p class="eyebrow">Footer CTA</p>
			<h2 id="footer-cta-title">Start with one session, then let the system keep you moving.</h2>
			<p>
				WeFitNest is designed to look sharp, stay usable on small screens, and keep the path from
				interest to install as short as possible.
			</p>
		</div>
		<div class="footer-actions">
			<a class="cta cta-primary" href="#app-store">Get the App</a>
			<a class="cta cta-secondary" href="#tutorial">Read the tutorial</a>
		</div>
	</div>
	<footer class="site-footer">
		<p>WeFitNest</p>
		<nav aria-label="Footer links">
			<a href="#feature-highlights">Features</a>
			<a href="#tutorial">Tutorial</a>
			<a href="#screenshots">Screenshots</a>
			<a href="#faq">FAQ</a>
		</nav>
	</footer>
</section>

<style>
	.section-block {
		width: min(var(--wf-content-width), calc(100% - var(--wf-space-6)));
		margin: 0 auto var(--wf-space-8);
		display: grid;
		gap: var(--wf-space-4);
	}

	.footer-card {
		padding: clamp(1.2rem, 3vw, 2rem);
		border-radius: var(--wf-radius-panel);
		background: linear-gradient(160deg, rgba(8, 41, 60, 0.98) 0%, rgba(10, 89, 136, 0.98) 52%, rgba(20, 151, 153, 0.98) 100%);
		color: #ffffff;
		box-shadow: 0 24px 52px rgba(6, 73, 107, 0.22);
		display: grid;
		gap: var(--wf-space-4);
	}

	.footer-copy {
		display: grid;
		gap: var(--wf-space-3);
	}

	.eyebrow {
		margin: 0;
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 0.42rem 0.88rem;
		border-radius: var(--wf-radius-pill);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.16);
	}

	h2 {
		font-size: clamp(1.8rem, 4.5vw, 3rem);
		line-height: 1;
		max-width: 12ch;
	}

	p {
		max-width: 44ch;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.9);
	}

	.footer-actions {
		display: flex;
		gap: var(--wf-space-3);
		flex-wrap: wrap;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.92rem 1.25rem;
		border-radius: var(--wf-radius-pill);
		font-weight: 800;
		text-decoration: none;
		transition:
			transform var(--wf-motion-fast) var(--wf-ease-standard),
			box-shadow var(--wf-motion-fast) var(--wf-ease-standard);
	}

	.cta-primary {
		background: rgba(255, 255, 255, 0.96);
		color: var(--wf-color-brand-deep);
		box-shadow: 0 14px 30px rgba(4, 40, 61, 0.18);
	}

	.cta-secondary {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.22);
	}

	.cta:hover,
	.cta:focus-visible {
		transform: translateY(-2px);
	}

	.site-footer {
		display: flex;
		justify-content: space-between;
		gap: var(--wf-space-3);
		align-items: center;
		padding: 0.25rem 0.15rem 0;
		flex-wrap: wrap;
	}

	.site-footer p {
		margin: 0;
		font-weight: 800;
		color: var(--wf-color-text);
	}

	.site-footer nav {
		display: flex;
		gap: var(--wf-space-3);
		flex-wrap: wrap;
	}

	.site-footer a {
		text-decoration: none;
		font-weight: 700;
		color: var(--wf-color-text-muted);
	}

	.site-footer a:hover,
	.site-footer a:focus-visible {
		color: var(--wf-color-brand-deep);
	}

	@media (min-width: 840px) {
		.footer-card {
			grid-template-columns: 1.1fr auto;
			align-items: center;
		}

		.footer-actions {
			justify-self: end;
		}
	}
</style>