---
import logo from '../assets/webAssets/wefitnest-logo.png';
---

<header class="site-header" role="banner">
	<a href="/" class="header-logo-link" aria-label="WeFitNest home">
		<img
			class="header-logo"
			src={logo.src}
			alt="WeFitNest logo"
			width={logo.width}
			height={logo.height}
			loading="eager"
			decoding="async"
		/>
	</a>
	<span class="header-wordmark" aria-hidden="true">WEFITNEST</span>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.7rem clamp(1rem, 4vw, 2rem);
		background: rgba(10, 10, 10, 0.72);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		border-bottom: 1px solid var(--wf-color-border);
	}

	.header-logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.header-logo {
		width: 2.4rem;
		height: auto;
	}

	.header-wordmark {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		background: linear-gradient(135deg, #2196f3 0%, #00bcd4 60%, #14cba8 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
</style>
